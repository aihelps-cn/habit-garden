# 必填：改为你的真实域名，不能带结尾斜杠或路径。
PUBLIC_ORIGIN=https://hz.aihelps.cn
# 两个独立随机密码，不要使用示例值。建议只使用英文、数字、下划线，避免 Compose 插值。
MYSQL_PASSWORD=replace_with_a_long_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password
APP_PORT=8080
# 默认只暴露给服务器本机反向代理。
BIND_ADDRESS=127.0.0.1
# HTTPS 部署保持 true。临时使用 HTTP 服务器 IP 测试时改为 false。
COOKIE_SECURE=true
# 只有反向代理是唯一可信入口时设为 1，否则保持 0。
TRUST_PROXY=0
